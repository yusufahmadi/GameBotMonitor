                                    <TextBlock x:Name="SecStorageHeader" Text="Tangkapan Layar &amp; Pembersihan (Auto-Cleanup):" FontWeight="SemiBold" FontSize="12" Foreground="#F9E2AF"/>
                                    <CheckBox x:Name="ChkCropHudOnly" Content="Cukup kirim potongan bar darah / HUD karakter saja (Ukuran: 225x92 px)" IsChecked="True" Margin="0,8,0,6"/>
                                    <TextBlock x:Name="TxtStorageInfo1" Text="• Tangkapan layar otomatis disimpan ke: Capture/yyyy/MM/dd/" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtStorageInfo2" Text="• Otomatis menyimpan hanya 3 hari terakhir (folder lebih lama langsung dibersihkan)" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtStorageInfo3" Text="• Di setiap folder harian, maksimal tersimpan 10 tangkapan layar terakhir" FontSize="11" Foreground="#A6ADC8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Docked Bottom Save Button -->
                    <Border Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="0,1,0,0" Padding="16,12">
                        <Button x:Name="BtnSaveSettings" Content="💾 Simpan Semua Pengaturan" Height="40" FontSize="14" FontWeight="Bold" Style="{StaticResource PrimaryButton}" Click="BtnSaveSettings_Click"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</Grid>
</Window>

