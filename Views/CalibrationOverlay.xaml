<Window x:Class="GameBotMonitor.Views.CalibrationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalibrasi Bar HP"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        WindowState="Maximized"
        Topmost="True"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Banner Petunjuk di Bagian Atas -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Background="#EE1E1E2E" CornerRadius="12" Padding="24,16"
                BorderBrush="#FF6C5CE7" BorderThickness="2">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎯 MODE KALIBRASI BAR HP" 
                           FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtInstruction" Text="Arahkan kursor dan KLIK 1 KALI tepat di bar darah jendela game." 
                           FontSize="14" Foreground="#FFDDDDEE" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Tips: Klik di bagian ujung kiri bar HP (sekitar 5% dari kiri bar). Tekan [ESC] untuk membatalkan." 
                           FontSize="12" Foreground="#FFAAAAAA" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
